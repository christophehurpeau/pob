# Generated by pob: do not edit, it is overwritten on each pob run.
name: Push CI
permissions:
  contents: read
on: [push]

jobs:
  build:
    runs-on: ubuntu-latest

    strategy:
      matrix:
        node-version: [24.x]

    steps:
      - uses: actions/checkout@v7

      - name: Install bun
        uses: oven-sh/setup-bun@v2
        with:
          bun-version: latest

      - name: Use Node.js ${{ matrix.node-version }}
        uses: actions/setup-node@v7
        with:
          node-version: ${{ matrix.node-version }}
          registry-url: "https://registry.npmjs.org"

      - name: Install Dependencies
        run: bun install --frozen-lockfile

      - name: Build
        run: bun run build

      - name: Format
        run: bun run format:check
        if: startsWith(matrix.node-version, '24.')

      - name: Typescript
        run: bun run tsc
        if: startsWith(matrix.node-version, '24.')

      - name: Oxlint
        run: bun run lint:oxlint
        if: startsWith(matrix.node-version, '24.')

      - name: Eslint
        run: bun run lint:eslint
        if: startsWith(matrix.node-version, '24.')

      - name: Check nothing was forgotten before commit
        if: startsWith(matrix.node-version, '24.')
        run: bun run repository-check-dirty
