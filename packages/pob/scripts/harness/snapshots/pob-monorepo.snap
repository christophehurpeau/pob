      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm run clean:build && rollup --config rollup.config.mjs",
    "clean": "pnpm run clean:build",
    "clean:build": "pob-esbuild-clean-out dist",
    "lint": "pnpm run lint:oxlint && pnpm run lint:eslint",
    "lint:eslint": "pnpm --dir '../..' exec eslint --quiet '@pob/version'",
    "lint:oxlint": "pnpm --dir '../..' exec oxlint --quiet '@pob/version'",
    "start": "pnpm run clean:build && rollup --config rollup.config.mjs --watch",
    "test": "pnpm run --dir '../..' test -- '@pob/version'",
    "tsc": "tsrs",
    "tsc:go": "tsc"
  },
  "dependencies": {
    "commander": "15.1.0",
    "conventional-changelog-conventionalcommits": "10.4.1",
