# Generated by pob: do not edit, it is overwritten on each pob run.
name: Push CI
permissions:
  contents: read
on: [push]

jobs:
  build:
    runs-on: ubuntu-latest

    strategy:
      matrix:
        node-version: [24.x]

    steps:
      - uses: actions/checkout@v7

      - name: Install pnpm
        uses: pnpm/action-setup@v6

      - name: Use Node.js ${{ matrix.node-version }}
        uses: actions/setup-node@v7
        with:
          node-version: ${{ matrix.node-version }}
          registry-url: "https://registry.npmjs.org"

      - name: Install Dependencies
        run: pnpm install --frozen-lockfile

      - name: Build
        run: pnpm run build

      - name: Format
        run: pnpm run format:check
        if: startsWith(matrix.node-version, '24.')

      - name: Typescript
        run: pnpm run tsc
        if: startsWith(matrix.node-version, '24.')

      - name: Oxlint
        run: pnpm run lint:oxlint
        if: startsWith(matrix.node-version, '24.')

      - name: Eslint
        run: pnpm run lint:eslint
        if: startsWith(matrix.node-version, '24.')

      - name: Check nothing was forgotten before commit
        if: startsWith(matrix.node-version, '24.')
        run: pnpm exec repository-check-dirty

      - name: Generate Test Coverage
        run: pnpm run test:coverage:generate
        if: startsWith(matrix.node-version, '24.')
        env:
          CI: true

      - name: Send results to codecov
        uses: codecov/codecov-action@v7
        with:
          fail_ci_if_error: true
          token: ${{ secrets.CODECOV_TOKEN }}
          files: ./coverage/coverage-final.json
          disable_search: true
        if: startsWith(matrix.node-version, '24.') && github.actor != 'dependabot[bot]'
>>>>> pob-harness created: .github/workflows/release.yml
# Generated by pob: do not edit, it is overwritten on each pob run.
name: Release
on:
  workflow_dispatch:
    inputs:
      dry-run:
        description: "Dry run"
        required: true
        type: boolean
        default: false
      allow-no-tags:
        description: "Allow no tags"
        required: false
        type: boolean
        default: false
      force:
        description: "Force bump all packages, even without changes"
        required: true
        type: choice
        options:
          - none
          - major
          - minor
          - patch
        default: none

permissions:
  id-token: write # Required for OIDC
  contents: write

jobs:
  release:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
        with:
          ssh-key: ${{ secrets.PUSH_DEPLOY_KEY }}
          fetch-depth: 0
          fetch-tags: true

      - name: Install pnpm
        uses: pnpm/action-setup@v6

      - uses: actions/setup-node@v7
        with:
          node-version: 24
          registry-url: "https://registry.npmjs.org"

      - name: Check git tags
        if: github.ref == 'refs/heads/main' && !inputs.allow-no-tags
        run: |
          tags=$(git tag)
          if [ -z "$tags" ]; then
            echo "No git tags found"
            exit 1
          fi
      - name: Install Dependencies
        run: pnpm install --frozen-lockfile

      - name: Build
        run: pnpm run build

      - name: New version (dry run)
        if: github.ref == 'refs/heads/main' && inputs.dry-run
        run: pnpm exec pob-version --dry-run ${{ inputs.force != 'none' && format('--force={0}', inputs.force) || '' }}

      - name: Configure Git user
        if: github.ref == 'refs/heads/main' && !inputs.dry-run
        run: |
          git config --global user.name 'github-actions[bot]'
          git config --global user.email 'github-actions[bot]@users.noreply.github.com'

      - name: New version
        if: github.ref == 'refs/heads/main' && !inputs.dry-run
        run: |
          pnpm exec pob-version --create-release=github ${{ inputs.force != 'none' && format('--force={0}', inputs.force) || '' }} -m 'chore: release %v [skip ci]'
        env:
          POB_GIT_HOOKS: 0
          YARN_ENABLE_IMMUTABLE_INSTALLS: false
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}

      - name: Publish to npm
        if: github.ref == 'refs/heads/main' && !inputs.dry-run
        run: |
          pnpm publish --no-git-checks --provenance
