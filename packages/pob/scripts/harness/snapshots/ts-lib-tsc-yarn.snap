# Generated by pob: do not edit, it is overwritten on each pob run.
name: Push CI
permissions:
  contents: read
on: [push]

jobs:
  build:
    runs-on: ubuntu-latest

    strategy:
      matrix:
        node-version: [24.x]

    steps:
      - uses: actions/checkout@v7

      - name: Enable Corepack
        run: corepack enable

      - name: Use Node.js ${{ matrix.node-version }}
        uses: actions/setup-node@v7
        with:
          node-version: ${{ matrix.node-version }}
          registry-url: "https://registry.npmjs.org"

      - name: Install Dependencies
        run: yarn install --immutable

      - name: Build
        run: yarn run build

      - name: Format
        run: yarn run format:check
        if: startsWith(matrix.node-version, '24.')

      - name: Typescript
        run: yarn run tsc
        if: startsWith(matrix.node-version, '24.')

      - name: Oxlint
        run: yarn run lint:oxlint
        if: startsWith(matrix.node-version, '24.')

      - name: Eslint
        run: yarn run lint:eslint
        if: startsWith(matrix.node-version, '24.')

      - name: Check nothing was forgotten before commit
        if: startsWith(matrix.node-version, '24.')
        run: yarn repository-check-dirty

      - name: Test
        run: yarn run test
        env:
          CI: true
>>>>> pob-harness created: .github/workflows/release.yml
# Generated by pob: do not edit, it is overwritten on each pob run.
name: Release
on:
  workflow_dispatch:
    inputs:
      dry-run:
        description: "Dry run"
        required: true
        type: boolean
        default: false
      allow-no-tags:
        description: "Allow no tags"
        required: false
        type: boolean
        default: false
      force:
        description: "Force bump all packages, even without changes"
        required: true
        type: choice
        options:
          - none
          - major
          - minor
          - patch
        default: none

permissions:
  id-token: write # Required for OIDC
  contents: write

jobs:
  release:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
        with:
          ssh-key: ${{ secrets.PUSH_DEPLOY_KEY }}
          fetch-depth: 0
          fetch-tags: true

      - name: Enable Corepack
        run: corepack enable

      - uses: actions/setup-node@v7
        with:
          node-version: 24
          registry-url: "https://registry.npmjs.org"

      - name: Check git tags
        if: github.ref == 'refs/heads/main' && !inputs.allow-no-tags
        run: |
          tags=$(git tag)
          if [ -z "$tags" ]; then
            echo "No git tags found"
            exit 1
          fi

      - name: Install Dependencies
        run: yarn install --immutable

      - name: Build
        run: yarn run build

      - name: New version (dry run)
        if: github.ref == 'refs/heads/main' && inputs.dry-run
        run: yarn pob-version --dry-run ${{ inputs.force != 'none' && format('--force={0}', inputs.force) || '' }}

      - name: Configure Git user
        if: github.ref == 'refs/heads/main' && !inputs.dry-run
        run: |
          git config --global user.name 'github-actions[bot]'
          git config --global user.email 'github-actions[bot]@users.noreply.github.com'

      - name: New version
        if: github.ref == 'refs/heads/main' && !inputs.dry-run
        run: |
          yarn pob-version --create-release=github ${{ inputs.force != 'none' && format('--force={0}', inputs.force) || '' }} -m 'chore: release %v [skip ci]'
        env:
          POB_GIT_HOOKS: 0
          YARN_ENABLE_IMMUTABLE_INSTALLS: false
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}

      - name: Publish to npm
        if: github.ref == 'refs/heads/main' && !inputs.dry-run
        run: |
          yarn npm publish --provenance
