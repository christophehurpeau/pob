{
  "extends": [
    "@pob/root/tsconfigs/strict.json",
    "@pob/root/tsconfigs/targets/node-24.json"
  ],
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "composite": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "tsBuildInfoFile": "node_modules/.cache/tsc/tsbuildinfo",
    "noEmit": true
  },
  "include": [
    "lib/**/*.js",
    "src/**/*.ts",
    "harness/**/*.ts",
    "scripts/**/*.ts"
  ]
}
