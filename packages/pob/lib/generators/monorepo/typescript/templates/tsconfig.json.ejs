{
  "files": [],
  "references": [
<% packagePaths.forEach((packagePath, index) => { -%>
    { "path": "<%= packagePath %>/tsconfig<%= tsConfigSuffix ? `.${tsConfigSuffix}` : '' %>.json" }<%= index === packagePaths.length -1 && !hasTools ? '' : ',' %>
<% }) -%>
<% if (hasTools) { -%>
    { "path": "tsconfig.tools.json" }
<% } -%>
  ]
}
