{
  "extends": [
    "@pob/root/tsconfigs/strict.json",
    "@pob/root/tsconfigs/targets/node-<%= nodeVersion %>.json"
  ],
  "include": [
    "*.config.ts",
    "*.config.mts",
    "*.config.cts",
    "scripts/**/*.ts",
    "scripts/**/*.mts",
    "scripts/**/*.cts",
<% workspaceGlobs.forEach((workspaceGlob, index) => { -%>
    "<%= workspaceGlob %>/scripts/**/*.ts",
    "<%= workspaceGlob %>/scripts/**/*.mts",
    "<%= workspaceGlob %>/scripts/**/*.cts",
    "<%= workspaceGlob %>/e2e/**/*.ts",
    "<%= workspaceGlob %>/e2e/**/*.mts",
    "<%= workspaceGlob %>/e2e/**/*.cts"<%= index === workspaceGlobs.length - 1 ? '' : ',' %>
<% }) -%>
  ],
  "compilerOptions": {
    "noEmit": true,
    "tsBuildInfoFile": "node_modules/.cache/tsc/tsbuildinfo-tools",
    "incremental": true,
    "resolveJsonModule": true
  }
}
