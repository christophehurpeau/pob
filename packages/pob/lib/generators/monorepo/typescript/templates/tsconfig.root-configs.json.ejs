{
  "extends": [
    "@pob/root/tsconfigs/strict.json",
    "@pob/root/tsconfigs/targets/node-<%= nodeVersion %>.json"
  ],
  "include": ["*.config.ts", "*.config.mts", "*.config.cts"],
  "compilerOptions": {
    "noEmit": true,
    "tsBuildInfoFile": "node_modules/.cache/tsc/tsbuildinfo-root-configs",
    "incremental": true,
    "resolveJsonModule": true
  }
}
