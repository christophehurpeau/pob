# Generated by pob: do not edit, it is overwritten on each pob run.
[install]
# Only install package versions published at least 2.5 days ago
minimumReleaseAge = 216000 # seconds
minimumReleaseAgeExcludes = [
<% for (const name of minimumReleaseAgeExcludes) { -%>
  <%- JSON.stringify(name) %>,
<% } -%>
]

[test]
# dist is build output: its compiled *.test.js copies would otherwise run too.
pathIgnorePatterns = ["**/dist/**"]
