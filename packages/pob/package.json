{
  "name": "pob",
  "version": "40.9.1",
  "description": "Pile of bones, library generator with git/babel/typescript/typedoc/readme/vitest",
  "keywords": [
    "skeleton"
  ],
  "homepage": "https://github.com/christophehurpeau/pob",
  "bugs": {
    "url": "https://github.com/christophehurpeau/pob/issues"
  },
  "license": "ISC",
  "author": "Christophe Hurpeau <christophe@hurpeau.com> (http://christophe.hurpeau.com/)",
  "repository": {
    "type": "git",
    "url": "https://github.com/christophehurpeau/pob.git",
    "directory": "packages/pob"
  },
  "bin": "./dist/index-node.mjs",
  "files": [
    "src",
    "dist",
    "bin",
    "!**/*.test.*"
  ],
  "type": "module",
  "sideEffects": true,
  "main": "./dist/index-node.mjs",
  "types": "./dist/definitions/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/definitions/index.d.ts",
      "node": {
        "import": "./dist/index-node.mjs"
      }
    }
  },
  "scripts": {
    "build": "pnpm run clean:build && rollup --config rollup.config.mjs && pnpm run build:definitions",
    "build:definitions": "tsrs -p tsconfig.json",
    "clean:build": "pob-esbuild-clean-out dist",
    "generate:schema": "node scripts/generate-schema.ts",
    "harness": "node scripts/harness/run.ts",
    "harness:update": "node scripts/harness/run.ts --update",
    "lint": "pnpm run lint:oxlint && pnpm run lint:eslint",
    "lint:eslint": "pnpm --dir '../..' exec eslint --quiet 'packages/pob'",
    "lint:oxlint": "pnpm --dir '../..' exec oxlint --quiet 'packages/pob'",
    "tsc": "tsrs",
    "tsc:go": "tsc"
  },
  "dependencies": {
    "@pob/codemods": "workspace:*",
    "@pob/eslint-config": "workspace:*",
    "@pob/eslint-config-typescript-react": "workspace:*",
    "@pob/sort-object": "workspace:*",
    "@pob/sort-pkg": "workspace:*",
    "eslint": "10.15.0",
    "js-yaml": "^5.2.1",
    "json5": "^2.2.3",
    "lodash.camelcase": "^4.3.0",
    "oxfmt": "0.78.0",
    "parse-author": "2.0.0",
    "pob-dependencies": "workspace:*",
    "semver": "7.8.6",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "devDependencies": {
    "@pob/rollup-esbuild": "workspace:*",
    "@pob/root": "workspace:*",
    "@types/node": "24.19.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "tsrs": "0.25.0-ts7.1.0-beta"
  },
  "engines": {
    "node": "^24.22.1 || >=26.13.0"
  },
  "pob": {
    "bundler": "rollup-esbuild",
    "entries": [
      "index"
    ],
    "envs": [
      {
        "target": "node",
        "version": "24",
        "omitVersionInFileName": true,
        "executable": true
      }
    ],
    "typescript": true
  }
}
