{
  "name": "pob-dependencies",
  "version": "28.1.0",
  "description": "easier dependencies upgrade with a real package.json",
  "keywords": [],
  "homepage": "https://github.com/christophehurpeau/pob",
  "bugs": {
    "url": "https://github.com/christophehurpeau/pob/issues"
  },
  "license": "ISC",
  "author": "Christophe Hurpeau <christophe@hurpeau.com> (https://christophe.hurpeau.com)",
  "repository": {
    "type": "git",
    "url": "https://github.com/christophehurpeau/pob.git",
    "directory": "packages/pob-dependencies"
  },
  "files": [
    "lib"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm run build:definitions",
    "build:definitions": "tsrs --lib esnext --noEmit --skipLibCheck ./lib/index.d.ts",
    "lint": "pnpm run lint:oxlint && pnpm run lint:eslint",
    "lint:eslint": "pnpm --dir '../..' exec eslint --quiet 'packages/pob-dependencies'",
    "lint:oxlint": "pnpm --dir '../..' exec oxlint --quiet 'packages/pob-dependencies'",
    "preversion": "node ./scripts/update-peerdeps.js && node ./scripts/generate.d.ts.js && git add lib/index.d.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@pob/esbuild": "workspace:*",
    "@pob/eslint-config": "workspace:*",
    "@pob/eslint-config-typescript-react": "workspace:*",
    "@pob/pretty-pkg": "workspace:*",
    "@pob/rollup-esbuild": "workspace:*",
    "@pob/rollup-typescript": "workspace:*",
    "@types/node": "24.19.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "5.0.3",
    "alp-rollup-plugin-config": "4.1.1",
    "eslint": "10.12.0",
    "pinst": "3.0.0",
    "playwright": "1.64.0",
    "rollup": "4.60.4",
    "semver": "7.8.5",
    "tslib": "2.8.1",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typedoc": "0.28.20",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "pob": {}
}
