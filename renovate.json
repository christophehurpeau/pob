{
  "extends": ["config:js-lib"],
  "prConcurrentLimit": 10,
  "dependencyDashboard": true,
  "dependencyDashboardApproval": false,
  "postUpdateOptions": ["yarnDedupeFewer", "yarnDedupeHighest", "pnpmDedupe"],
  "labels": [":vertical_traffic_light: automerge"],
  "rangeStrategy": "bump",
  "minimumReleaseAge": "60 hours",
  "internalChecksFilter": "strict",
  "vulnerabilityAlerts": {
    "minimumReleaseAge": null
  },
  "packageRules": [
    {
      "description": "keep in sync with minimumReleaseAgeExclude in pnpm-workspace.yaml",
      "matchPackageNames": [
        "@pob/*",
        "pob",
        "pob-dependencies",
        "check-package-dependencies",
        "alouette",
        "alouette-icons",
        "nightingale",
        "nightingale-logger"
      ],
      "minimumReleaseAge": null
    },
    {
      "semanticCommitType": "chore",
      "matchPackageNames": ["*"]
    },
    {
      "matchDepTypes": ["dependencies"],
      "matchUpdateTypes": ["patch"],
      "semanticCommitType": "fix"
    },
    {
      "matchDepTypes": ["dependencies"],
      "matchUpdateTypes": ["minor", "major"],
      "semanticCommitType": "feat"
    },
    {
      "matchFileNames": ["packages/pob-dependencies"],
      "matchDepTypes": ["devDependencies"],
      "semanticCommitType": "feat"
    },
    {
      "groupName": "react",
      "description": "react monorepo",
      "matchPackageNames": [
        "@hot-loader/react-dom",
        "@types/react",
        "@types/react-dom"
      ],
      "matchSourceUrls": ["https://github.com/facebook/react{/,}**"]
    },
    {
      "groupName": "nightingale",
      "description": "nightingale monorepo",
      "matchSourceUrls": [
        "https://github.com/christophehurpeau/nightingale{/,}**"
      ]
    },
    {
      "groupName": "alp",
      "description": "alp monorepo",
      "matchSourceUrls": ["https://github.com/christophehurpeau/alp{/,}**"]
    },
    {
      "groupName": "liwi",
      "description": "liwi monorepo",
      "matchSourceUrls": ["https://github.com/liwijs/liwi{/,}**"]
    },
    {
      "groupName": "yeoman group",
      "description": "yeoman-environment and @yeoman/types depend on mem-fs: its majors land with theirs",
      "matchPackageNames": ["yeoman-*", "@yeoman/*", "mem-fs", "mem-fs-editor"]
    },
    {
      "matchUpdateTypes": ["patch", "minor"],
      "labels": [
        ":ok_hand: code/approved",
        ":vertical_traffic_light: automerge"
      ]
    },
    {
      "matchUpdateTypes": ["pin"],
      "labels": [
        ":ok_hand: code/approved",
        ":vertical_traffic_light: automerge"
      ],
      "schedule": ["at any time"]
    },
    {
      "groupName": "conventional changelog",
      "description": "conventional-changelog monorepo",
      "matchSourceUrls": [
        "https://github.com/conventional-changelog/conventional-changelog{/,}**"
      ]
    },
    {
      "groupName": "conventional changelog and commitlint",
      "description": "open conventional-changelog and commitlint majors together",
      "matchSourceUrls": [
        "https://github.com/conventional-changelog/conventional-changelog{/,}**",
        "https://github.com/conventional-changelog/commitlint{/,}**"
      ],
      "matchUpdateTypes": ["major"]
    },
    {
      "matchPackageNames": [
        "eslint",
        "typescript",
        "@typescript/typescript6",
        "@typescript-eslint/*",
        "eslint-*",
        "typescript-eslint",
        "@eslint/*"
      ],
      "dependencyDashboardApproval": false,
      "reviewers": ["christophehurpeau"]
    },
    {
      "description": "tsrs only publishes prereleases (e.g. 0.18.0-ts7.1.0-dev.20260929), which Renovate skips by default",
      "matchPackageNames": ["tsrs"],
      "ignoreUnstable": false,
      "reviewers": ["christophehurpeau"]
    },
    {
      "description": "jscodeshift 17.4.0 depends on @babel/parser ^7 (check-package-dependencies refuses a second line in @pob/codemods): remove when jscodeshift depends on @babel/parser ^8",
      "matchPackageNames": ["@babel/parser"],
      "allowedVersions": "<8"
    },
    {
      "groupName": "pnpm",
      "matchPackageNames": ["pnpm"],
      "rangeStrategy": "replace",
      "semanticCommitType": "feat"
    }
  ]
}
