{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "@pob:target:Bun",

  "compilerOptions": {
    "target": "esnext",
    "lib": ["esnext"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "esModuleInterop": true,
    "types": ["bun"]
  }
}
