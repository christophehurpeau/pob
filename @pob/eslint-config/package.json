{
  "name": "@pob/eslint-config",
  "version": "68.0.0",
  "description": "eslint config files",
  "keywords": [],
  "homepage": "https://github.com/christophehurpeau/pob",
  "bugs": {
    "url": "https://github.com/christophehurpeau/pob/issues"
  },
  "license": "ISC",
  "author": "Christophe Hurpeau <christophe@hurpeau.com> (http://christophe.hurpeau.com/)",
  "repository": {
    "type": "git",
    "url": "https://github.com/christophehurpeau/pob.git",
    "directory": "@pob/eslint-config"
  },
  "files": [
    "lib",
    "oxlint/allow-implicit-return-type.json",
    "oxlint/allow-unsafe-as-warn.json",
    "oxlint/allow-unsafe.json",
    "oxlint/app.json",
    "oxlint/base.json",
    "oxlint/commonjs.json",
    "oxlint/module.json",
    "oxlint/node.json",
    "oxlint/typescript.json",
    "utils.js"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./oxlint/allow-implicit-return-type.json": "./oxlint/allow-implicit-return-type.json",
    "./oxlint/allow-unsafe.json": "./oxlint/allow-unsafe.json",
    "./oxlint/allow-unsafe-as-warn.json": "./oxlint/allow-unsafe-as-warn.json",
    "./oxlint/app.json": "./oxlint/app.json",
    "./oxlint/base.json": "./oxlint/base.json",
    "./oxlint/commonjs.json": "./oxlint/commonjs.json",
    "./oxlint/module.json": "./oxlint/module.json",
    "./oxlint/node.json": "./oxlint/node.json",
    "./oxlint/typescript.json": "./oxlint/typescript.json",
    "./utils": "./utils.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "pnpm run lint:oxlint && pnpm run lint:eslint",
    "lint:eslint": "pnpm --dir '../..' exec eslint --quiet '@pob/eslint-config'",
    "lint:oxlint": "pnpm --dir '../..' exec oxlint --quiet '@pob/eslint-config'"
  },
  "dependencies": {
    "@eslint/json": "^2.0.0",
    "@pob/eslint-plugin": "workspace:*",
    "@typescript-eslint/parser": "8.72.0",
    "check-package-dependencies": "^13.2.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-regexp": "^3.1.0",
    "eslint-plugin-unicorn": "^64.0.0"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "eslint": "10.12.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-n": "17.24.0",
    "eslint-plugin-regexp": "3.1.0",
    "eslint-plugin-unicorn": "64.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "peerDependencies": {
    "eslint": "^10.8.0",
    "typescript": ">=5.0.0 <8.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "pob": {}
}
