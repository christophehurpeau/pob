{
  "name": "@pob/sort-pkg",
  "version": "13.4.0",
  "description": "sort package.json",
  "keywords": [],
  "homepage": "https://github.com/christophehurpeau/pob",
  "bugs": {
    "url": "https://github.com/christophehurpeau/pob/issues"
  },
  "license": "ISC",
  "author": "Christophe Hurpeau <christophe@hurpeau.com> (https://christophe.hurpeau.com)",
  "repository": {
    "type": "git",
    "url": "https://github.com/christophehurpeau/pob.git",
    "directory": "@pob/sort-pkg"
  },
  "files": [
    "lib"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "pnpm run lint:oxlint && pnpm run lint:eslint",
    "lint:eslint": "pnpm --dir '../..' exec eslint --quiet '@pob/sort-pkg'",
    "lint:oxlint": "pnpm --dir '../..' exec oxlint --quiet '@pob/sort-pkg'"
  },
  "dependencies": {
    "@pob/sort-object": "workspace:*"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.13.0"
  },
  "pob": {}
}
