{
  "name": "@pob/eslint-config-typescript-react",
  "version": "68.5.0",
  "description": "eslint config files",
  "keywords": [],
  "homepage": "https://github.com/christophehurpeau/pob",
  "bugs": {
    "url": "https://github.com/christophehurpeau/pob/issues"
  },
  "license": "ISC",
  "author": "Christophe Hurpeau <christophe@hurpeau.com> (http://christophe.hurpeau.com/)",
  "repository": {
    "type": "git",
    "url": "https://github.com/christophehurpeau/pob.git",
    "directory": "@pob/eslint-config-typescript-react"
  },
  "files": [
    "lib",
    "oxlint/react.json",
    "oxlint/react-native.json",
    "oxlint/react-native-web.json"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./oxlint/react.json": "./oxlint/react.json",
    "./oxlint/react-native.json": "./oxlint/react-native.json",
    "./oxlint/react-native-web.json": "./oxlint/react-native-web.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "pnpm run lint:oxlint && pnpm run lint:eslint",
    "lint:eslint": "pnpm --dir '../..' exec eslint --quiet '@pob/eslint-config-typescript-react'",
    "lint:oxlint": "pnpm --dir '../..' exec oxlint --quiet '@pob/eslint-config-typescript-react'"
  },
  "dependencies": {
    "@pob/eslint-config": "workspace:*",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-react-x": "5.30.1"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "react": "19.3.1",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "peerDependencies": {
    "eslint": "^10.14.0",
    "typescript": ">=5.0.0 <8.0.0"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.13.0"
  },
  "pob": {
    "typescript": "check-only"
  }
}
